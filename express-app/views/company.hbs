<section class="page-heading"><p class="eyebrow">COMPANY PROFILE</p><h1>{{company.name}}</h1><p>{{company.description}}</p></section>
<section class="detail-grid"><div class="detail-panel"><p class="eyebrow">ABOUT THE ROLE</p><h2>Build your first chapter here.</h2><p>Location: <strong>{{company.location}}</strong></p><p>Expected package: <strong>{{company.package}}</strong></p></div><div class="detail-panel"><p class="eyebrow">OPEN POSITIONS</p><ul class="job-list">{{#each company.jobs}}<li><div><strong>{{title}}</strong><span>{{type}}</span></div><b>{{openings}} openings</b></li>{{/each}}</ul></div></section>
