<section class="page-heading"><p class="eyebrow">STUDENT REGISTER</p><h1>Placement progress</h1><p>A quick view of every registered student and their current status.</p></section>
<section class="student-list">{{#each students}}<article class="student-row"><div class="avatar">{{name.[0]}}</div><div><h2>{{name}}</h2><p>{{course}} &middot; {{year}}</p></div>{{#if (eq status 'Placed')}}<span class="status placed">{{status}}</span>{{else if (eq status 'Shortlisted')}}<span class="status shortlisted">{{status}}</span>{{else}}<span class="status registered">{{status}}</span>{{/if}}<a class="text-link" href="/student/{{id}}">Details &rarr;</a></article>{{/each}}</section>
