<section class="page-heading"><p class="eyebrow">STUDENT PROFILE</p><h1>{{student.name}}</h1><p>{{student.course}} &middot; {{student.year}}</p></section>
<section class="profile-card"><div class="avatar large">{{student.name.[0]}}</div><div><p class="eyebrow">PLACEMENT STATUS</p><span class="status {{statusClass student.status}}">{{student.status}}</span><dl><dt>Company</dt><dd>{{student.company}}</dd><dt>Role</dt><dd>{{student.job}}</dd><dt>Package</dt><dd>{{student.package}}</dd></dl></div></section>
